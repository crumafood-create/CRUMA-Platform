{
  "name": "crumafood-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "auth:test:roles": "vitest run --project unit src/modules/identity/legacy-role-contract.test.ts src/modules/identity/get-user-role.test.ts src/modules/identity/guards/auth.guard.test.ts src/modules/identity/guards/action.guard.test.ts",
    "production:test:orders": "vitest run --project unit src/modules/production/application/production-order-contract.test.ts",
    "production:test:mobile": "vitest run --project unit src/modules/production/application/mobile-production-contract.test.ts src/modules/production/application/mobile-production-repository.test.ts",
    "production:test:recipes": "vitest run --project unit src/modules/production/application/recipe-contract.test.ts src/modules/production/application/recipe-repository.test.ts src/modules/production/application/recipe-authorization.test.ts src/infrastructure/database/recipe-rls.test.ts",
    "production:test:costs": "vitest run --project unit src/modules/production/application/production-cost-contract.test.ts src/modules/production/application/production-cost-repository.test.ts src/modules/production/application/production-cost-snapshot.test.ts src/modules/production/application/production-cost-authorization.test.ts src/infrastructure/database/production-cost-rls.test.ts",
    "production:test:lots": "vitest run --project unit src/modules/production/application/production-lot-contract.test.ts src/modules/production/application/production-lot-repository.test.ts src/modules/production/application/production-lot-authorization.test.ts src/modules/production/application/production-lot-traceability.test.ts src/infrastructure/database/production-lot-rls.test.ts",
    "quality:test:control": "vitest run --project unit src/modules/quality/application/quality-control-contract.test.ts src/modules/quality/application/quality-control-repository.test.ts src/modules/quality/application/quality-control-authorization.test.ts src/infrastructure/database/quality-control-rls.test.ts",
    "inventory:test:movements": "vitest run --project unit src/modules/inventory/application/inventory-movement-contract.test.ts",
    "inventory:test:locations": "vitest run --project unit src/modules/inventory/application/inventory-location-contract.test.ts src/modules/inventory/application/inventory-location-repository.test.ts src/modules/inventory/application/inventory-location-authorization.test.ts",
    "inventory:test:warehouses": "vitest run --project unit src/modules/inventory/application/warehouse-contract.test.ts src/modules/inventory/application/warehouse-repository.test.ts src/modules/inventory/application/warehouse-authorization.test.ts src/infrastructure/database/warehouse-rls.test.ts",
    "procurement:test:suppliers": "vitest run --project unit src/modules/procurement/application/supplier-contract.test.ts src/modules/procurement/application/supplier-repository.test.ts src/modules/procurement/application/supplier-authorization.test.ts src/infrastructure/database/supplier-rls.test.ts",
    "procurement:test:orders": "vitest run --project unit src/modules/procurement/application/purchase-order-contract.test.ts src/modules/procurement/application/purchase-order-repository.test.ts src/modules/procurement/application/purchase-order-authorization.test.ts src/infrastructure/database/purchase-order-rls.test.ts",
    "procurement:test:requisitions": "vitest run --project unit src/modules/procurement/application/purchase-requisition-contract.test.ts src/modules/procurement/application/purchase-requisition-repository.test.ts src/modules/procurement/application/purchase-requisition-authorization.test.ts src/infrastructure/database/purchase-requisition-approval-rls.test.ts",
    "sales:test:orders": "vitest run --project unit src/modules/sales/application/sales-order-contract.test.ts src/modules/sales/application/sales-order-repository.test.ts src/modules/sales/application/sales-order-authorization.test.ts src/infrastructure/database/sales-order-rls.test.ts",
    "sales:test:customers": "vitest run --project unit src/modules/sales/application/customer-contract.test.ts src/modules/sales/application/customer-repository.test.ts src/modules/sales/application/customer-authorization.test.ts src/infrastructure/database/customer-rls.test.ts",
    "sales:test:quotes": "vitest run --project unit src/modules/sales/application/sales-quote-contract.test.ts src/modules/sales/application/sales-quote-repository.test.ts src/modules/sales/application/sales-quote-authorization.test.ts src/infrastructure/database/sales-quote-rls.test.ts",
    "finance:test:receivables": "vitest run --project unit src/modules/finance/application/receivable-payment-contract.test.ts src/modules/finance/application/receivable-payment-repository.test.ts src/modules/finance/application/receivable-authorization.test.ts src/infrastructure/database/receivable-rls.test.ts",
    "finance:test:invoices": "vitest run --project unit src/modules/finance/application/invoice-contract.test.ts src/modules/finance/application/invoice-repository.test.ts src/modules/finance/application/invoice-authorization.test.ts src/infrastructure/database/invoice-rls.test.ts",
    "inventory:test:units": "vitest run --project unit src/modules/inventory/application/unit-of-measure-contract.test.ts src/modules/inventory/application/unit-of-measure-repository.test.ts src/modules/inventory/application/unit-of-measure-authorization.test.ts src/infrastructure/database/unit-of-measure-rls.test.ts",
    "inventory:test:materials": "vitest run --project unit src/modules/inventory/application/raw-material-contract.test.ts src/modules/inventory/application/raw-material-repository.test.ts",
    "inventory:test:alerts": "vitest run --project unit src/modules/inventory/application/inventory-alert-contract.test.ts src/modules/inventory/application/inventory-alert-repository.test.ts",
    "inventory:test:products": "vitest run --project unit src/modules/inventory/application/product-catalog-contract.test.ts src/modules/inventory/application/product-catalog-repository.test.ts",
    "storefront:test:catalog": "vitest run --project unit src/modules/storefront/application/storefront-product-contract.test.ts src/modules/storefront/application/storefront-product-repository.test.ts src/components/storefront/storefront-product-grid.test.tsx src/infrastructure/database/storefront-product-rls.test.ts",
    "inventory:test:preparation-types": "vitest run --project unit src/modules/inventory/application/product-catalog-repository.test.ts src/modules/inventory/application/preparation-type-boundary.test.ts",
    "inventory:test:flavors": "vitest run --project unit src/modules/inventory/application/flavor-catalog-contract.test.ts src/modules/inventory/application/flavor-catalog-repository.test.ts src/modules/inventory/application/flavor-catalog-authorization.test.ts",
    "inventory:test:categories": "vitest run --project unit src/modules/inventory/application/category-family-contract.test.ts src/modules/inventory/application/category-family-repository.test.ts",
    "inventory:test:authorization": "vitest run --project unit src/modules/inventory/application/inventory-write-authorization.test.ts",
    "inventory:test:integrity": "vitest run --project unit src/modules/inventory/application/raw-material-integrity.test.ts src/modules/inventory/application/raw-material-contract.test.ts src/modules/inventory/application/raw-material-repository.test.ts src/modules/inventory/application/category-family-repository.test.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "db:toolchain": "supabase --version",
    "db:inventory": "node scripts/database/inventory-supabase-references.mjs",
    "db:history:compare": "node scripts/database/compare-migration-history.ts",
    "db:reconciliation:plan": "node scripts/database/plan-migration-reconciliation.ts",
    "db:reconciliation:prepare-production": "bash scripts/database/prepare-production-migration-reconciliation.sh",
    "db:reconciliation:execute-production": "node scripts/database/execute-production-reconciliation.ts",
    "db:reconciliation:rehearse": "bash scripts/database/run-migration-reconciliation-rehearsal.sh",
    "db:test:reconciliation": "vitest run --project unit src/infrastructure/database/migration-reconciliation.test.ts src/infrastructure/database/migration-rehearsal.test.ts src/infrastructure/database/production-reconciliation.test.ts src/infrastructure/database/production-reconciliation-execution.test.ts src/infrastructure/database/production-reconciliation-resume.test.ts",
    "db:test:migration-history": "vitest run --project unit src/infrastructure/database/migration-history.test.ts",
    "db:types:generate": "node scripts/database/manage-generated-types.ts generate",
    "db:types:check": "node scripts/database/manage-generated-types.ts check",
    "db:test:generated-types": "vitest run --project unit src/infrastructure/database/generated-types.test.ts",
    "db:test:client-contract": "vitest run --project unit src/infrastructure/database/supabase-client-contract.test.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "storybook:test:visual": "playwright test --config=playwright.visual.config.ts",
    "storybook:update-visual": "pnpm run build-storybook && playwright test --config=playwright.visual.config.ts --update-snapshots",
    "db:reset": "supabase db reset --network-id cruma-supabase-local",
    "db:lint": "supabase db lint --local --level error",
    "db:test:function-security": "bash scripts/database/run-database-test.sh supabase/tests/database/function_security.sql",
    "db:verify": "pnpm run db:reset:test && pnpm run db:lint && pnpm run db:test:security && pnpm run db:test:schema-contract && pnpm run db:test:seed-strategy && pnpm run db:test:migration-history && pnpm run db:test:reconciliation && pnpm run db:test:generated-types && pnpm run db:test:client-contract && pnpm run db:types:check",
    "db:test:table-privileges": "bash scripts/database/run-database-test.sh supabase/tests/database/table_privileges.sql",
    "db:test:security": "pnpm run db:test:function-security && pnpm run db:test:table-privileges && pnpm run db:test:rls-behavior && pnpm run db:test:receivables && pnpm run db:test:invoices && pnpm run db:test:quotes && pnpm run db:test:requisitions && pnpm run db:test:costs && pnpm run db:test:quality && pnpm run db:test:lots && pnpm run db:test:storefront && pnpm run db:test:forecasts && pnpm run db:test:reporting",
    "db:test:rls-behavior": "bash scripts/database/run-database-test.sh supabase/tests/database/rls_behavior.sql",
    "db:test:receivables": "bash scripts/database/run-database-test.sh supabase/tests/database/receivable_payments.sql",
    "db:test:invoices": "bash scripts/database/run-database-test.sh supabase/tests/database/commercial_invoicing.sql",
    "db:test:quotes": "bash scripts/database/run-database-test.sh supabase/tests/database/sales_quotes.sql",
    "db:test:requisitions": "bash scripts/database/run-database-test.sh supabase/tests/database/purchase_requisition_approvals.sql",
    "db:test:costs": "bash scripts/database/run-database-test.sh supabase/tests/database/production_costs.sql",
    "db:test:lots": "bash scripts/database/run-database-test.sh supabase/tests/database/production_lot_release.sql",
    "db:test:quality": "bash scripts/database/run-database-test.sh supabase/tests/database/quality_control.sql",
    "db:test:storefront": "bash scripts/database/run-database-test.sh supabase/tests/database/storefront_catalog.sql",
    "db:test:forecasts": "bash scripts/database/run-database-test.sh supabase/tests/database/demand_forecasts.sql",
    "db:test:reporting": "bash scripts/database/run-database-test.sh supabase/tests/database/business_reporting.sql",
    "db:test:schema-contract": "bash scripts/database/run-database-test.sh supabase/tests/database/schema_contract.sql",
    "db:seed:base": "bash scripts/database/run-database-test.sh supabase/seeds/base.sql",
    "db:seed:local": "pnpm run db:seed:base && bash scripts/database/run-database-test.sh supabase/seeds/local.sql",
    "db:seed:test": "pnpm run db:seed:base && bash scripts/database/run-database-test.sh supabase/seeds/test.sql",
    "db:reset:test": "supabase db reset --network-id cruma-supabase-local --no-seed && pnpm run db:seed:test",
    "db:test:seed-strategy": "pnpm run db:seed:test && bash scripts/database/run-database-test.sh supabase/tests/database/seed_strategy.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-query-devtools": "^5.66.9",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.511.0",
    "next": "15.5.19",
    "next-themes": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.1.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.19",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.19",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.6",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.3",
    "storybook": "^10.5.6",
    "supabase": "2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
