{
  "name": "crumafood-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "db:toolchain": "supabase --version",
    "db:inventory": "node scripts/database/inventory-supabase-references.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "storybook:test:visual": "playwright test --config=playwright.visual.config.ts",
    "storybook:update-visual": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "db:reset": "supabase db reset --network-id cruma-supabase-local",
    "db:lint": "supabase db lint --local --level error",
    "db:test:function-security": "bash scripts/database/run-database-test.sh supabase/tests/database/function_security.sql",
    "db:verify": "pnpm run db:reset && pnpm run db:lint && pnpm run db:test:security",
    "db:test:table-privileges": "bash scripts/database/run-database-test.sh supabase/tests/database/table_privileges.sql",
    "db:test:security": "pnpm run db:test:function-security && pnpm run db:test:table-privileges"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-query-devtools": "^5.66.9",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.511.0",
    "next": "15.5.19",
    "next-themes": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.1.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.19",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.19",
    "eslint-plugin-storybook": "^10.5.6",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.3",
    "storybook": "^10.5.6",
    "supabase": "2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
