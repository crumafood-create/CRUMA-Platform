{
  "compilerOptions": {

    "target": "ES2022",

    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],

    "allowJs": false,

    "skipLibCheck": true,

    "strict": true,

    "noEmit": true,

    "esModuleInterop": true,

    "module": "esnext",

    "moduleResolution": "bundler",

    "resolveJsonModule": true,

    "isolatedModules": true,

    "jsx": "preserve",

    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ],

    "baseUrl": ".",

    "paths": {

      "@/*": ["./src/*"],

      "@/app/*": ["./src/app/*"],

      "@/shared/*": ["./src/shared/*"],

      "@/domains/*": ["./src/domains/*"],

      "@/infrastructure/*": ["./src/infrastructure/*"],

      "@/providers/*": ["./src/providers/*"],

      "@/hooks/*": ["./src/hooks/*"],

      "@/types/*": ["./src/types/*"],

      "@/lib/*": ["./src/lib/*"]
    }
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
